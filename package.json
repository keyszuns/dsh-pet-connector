{
  "name": "dsh-pet-connector",
  "version": "0.78.0",
  "private": false,
  "description": "Connect your local dsh-pet to Big Fat Fish World: pairing, city and birthday five-elements, world presence, and a three-tab panel.",
  "type": "module",
  "icon": "icon.svg",
  "license": "MIT",
  "author": "keyszuns",
  "homepage": "https://github.com/keyszuns/dsh-pet-connector#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/keyszuns/dsh-pet-connector.git"
  },
  "bugs": {
    "url": "https://github.com/keyszuns/dsh-pet-connector/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "desktop-pet",
    "dsh-pet",
    "big-fat-fish",
    "game"
  ],
  "engines": {
    "dsh": ">=0.2.1"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "assets/globe3d.js",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
